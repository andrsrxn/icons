{
  "name": "andrsrxn-icons-monorepo",
  "private": true,
  "scripts": {
    "start": "turbo run start",
    "dev": "turbo run dev",
    "dev:icons": "turbo run dev --filter=@andrsrxn/icons",
    "dev:docs": "turbo run dev --filter=docs",
    "build": "turbo run build",
    "build:icons": "turbo run build --filter=@andrsrxn/icons",
    "build:raw-icons": "turbo run build --filter=@andrsrxn/raw-icons",
    "build:docs": "turbo run build --filter=docs",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "type:check": "turbo run type:check",
    "dep:check": "turbo run dep:check --continue",
    "react:check": "turbo run react:check --continue",
    "test": "turbo run test",
    "test:check": "turbo run test:check",
    "changeset": "changeset",
    "version-package": "changeset version && pnpm install --no-frozen-lockfile",
    "release": "pnpm build:icons && changeset publish",
    "generate-icons": "turbo run generate-icons",
    "generate-flags": "turbo run generate-flags",
    "generate-raw-metadata": "turbo run generate-raw-metadata"
  },
  "engines": {
    "node": "^24",
    "pnpm": "^11"
  },
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "turbo": "2.10.12",
    "prettier": "3.9.6",
    "@biomejs/biome": "2.5.6",
    "typescript": "7.0.2",
    "lefthook": "2.1.10",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1"
  }
}
