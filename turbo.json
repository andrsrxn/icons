{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env"],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.json"]
    },
    "lint:check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.json"]
    },
    "type:check": {
      "dependsOn": ["^build"],
      "outputs": [".tsbuildinfo"]
    },
    "test": {
      "persistent": true,
      "cache": false
    },
    "format": {},
    "format:check": {},
    "test:check": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dep:check": {
      "cache": false
    },
    "react:check": {
      "cache": false
    },
    "generate-icons": {
      "cache": false
    },
    "generate-flags": {
      "cache": false
    },
    "generate-raw-metadata": {
      "cache": false
    }
  }
}
