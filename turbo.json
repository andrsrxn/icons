{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env", "tsdown.config.ts", "tsconfig.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "tsconfig.json", "tsdown.config.ts"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "outputs": []
    },
    "lint:check": {
      "outputs": []
    },
    "type:check": {
      "dependsOn": ["^build"],
      "outputs": [".tsbuildinfo"]
    },
    "test": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "test:check": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dep:check": {
      "cache": false,
      "outputs": []
    },
    "react:check": {
      "cache": false,
      "outputs": []
    },
    "generate-icons": {
      "outputs": [],
      "cache": false
    },
    "generate-flags": {
      "outputs": [],
      "cache": false
    }
  }
}
